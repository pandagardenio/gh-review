{
  "manifest_version": 3,
  "name": "Triage",
  "version": "0.0.0",
  "description": "An alternative GitHub pull-request review flow for the agentic era.",
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/pull/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*", "https://api.github.com/*"]
}
