{
  "name": "@triage/web",
  "version": "0.0.0",
  "description": "Coding-factory Control Room — web cockpit (Observe / Configure / Review) over a dark-factory repo.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
