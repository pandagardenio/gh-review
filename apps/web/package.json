    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@triage/engine": "workspace:*",
    "@triage/fleet": "workspace:*",
    "@triage/ui": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "^25.0.0"
  }
}
